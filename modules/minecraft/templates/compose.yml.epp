<%- | String  $image,
      String  $container_name,
      Boolean $eula,
      String  $level,
      String  $mode,
      Integer $game_port,
      Integer $dynmap_port,
      Integer $bluemap_port,
      Array[String] $modrinth_projects,
      String  $restart_policy,
      String           $server_type,
      Optional[String] $custom_server = undef,
| -%>
services:
  mc:
    image: <%= $image %>
    container_name: <%= $container_name %>
    environment:
      EULA: "<%= $eula %>"
      TYPE: <%= $server_type %>
<% if $custom_server { -%>
      CUSTOM_SERVER: <%= $custom_server %>
<% } -%>
      LEVEL: <%= $level %>
      MODE: <%= $mode %>
<% unless $modrinth_projects.empty { -%>
      MODRINTH_PROJECTS: "<%= $modrinth_projects.join(',') %>"
<% } -%>
    ports:
      - "<%= $game_port %>:25565"
      - "<%= $dynmap_port %>:8123"
      - "<%= $bluemap_port %>:8100"
    volumes:
      - ${SERVER_DATA}:/data
    stdin_open: true
    tty: true
    restart: <%= $restart_policy %>
