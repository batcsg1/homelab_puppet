IMMICH_LOCATION="<%= scope.lookupvar('immich::immich_location') %>"
# The location where your uploaded files are stored
UPLOAD_LOCATION="${IMMICH_LOCATION}/storage"
# The location where your database files are stored
DB_DATA_LOCATION="${IMMICH_LOCATION}/db"

SAMUEL_EXTERNAL_LIBRARY="${IMMICH_LOCATION}/storage/external/admin"
CARMEN_EXTERNAL_LIBRARY="${IMMICH_LOCATION}/storage/external/1f6d1099-d3b2-4a90-894f-dee4a4f9d5de"

# Timezone
TZ=<%= scope.lookupvar('immich::timezone') %>
# The Immich version to use
IMMICH_VERSION=<%= scope.lookupvar('immich::immich_version') %>
# Connection secret for postgres
DB_PASSWORD=<%= scope.lookupvar('immich::db_password') %>
# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=<%= scope.lookupvar('immich::db_username') %>
DB_DATABASE_NAME=<%= scope.lookupvar('immich::db_database_name') %>
<% if scope.lookupvar('immich::cloudflare_tunnel_token') -%>
# API Token for Cloudflared tunnel
CLOUDFLARE_TUNNEL_TOKEN=<%= scope.lookupvar('immich::cloudflare_tunnel_token') %>
<% end -%>
