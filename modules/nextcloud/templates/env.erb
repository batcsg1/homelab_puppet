MYSQL_PASSWORD=<%= scope.lookupvar('nextcloud::mysql_password') %>

# Nextcloud mount points
NEXTCLOUD_HOME="<%= scope.lookupvar('nextcloud::nextcloud_home') %>"

# Nextcloud persistent data volumes
NEXTCLOUD_APP_DATA="${NEXTCLOUD_HOME}/data"
NEXTCLOUD_DB_DATA="${NEXTCLOUD_HOME}/db"
NEXTCLOUD_WWW="${NEXTCLOUD_HOME}/www/"

# Cloudflare tunnel .env variables
DOMAIN_NAME=<%= scope.lookupvar('nextcloud::domain_name') %>
<% if scope.lookupvar('nextcloud::cloudflare_tunnel_token') -%>
CLOUDFLARE_TUNNEL_TOKEN=<%= scope.lookupvar('nextcloud::cloudflare_tunnel_token') %>
<% end -%>
