<%- | String           $certname,
      String           $server,
      Optional[String] $ca_server,
      String           $runinterval,
      Optional[String] $dns_alt_names,
| -%>
[main]
certname = <%= $certname %>
server = <%= $server %>
runinterval = <%= $runinterval %>
<%- if $ca_server { -%>
ca_server = <%= $ca_server %>
<%- } -%>
<%- if $dns_alt_names { -%>
dns_alt_names = <%= $dns_alt_names %>
<%- } -%>
