JELLYFIN_HOME="<%= scope.lookupvar('jellyfin::jellyfin_home') %>"
# The location where Jellyfin's config and cache are stored
JELLYFIN_CONFIG="${JELLYFIN_HOME}/config"
JELLYFIN_CACHE="${JELLYFIN_HOME}/cache"
# The location of your media libraries (mounted read-only)
MEDIA_LOCATION="<%= scope.lookupvar('jellyfin::media_location') %>"

# Timezone
TZ=<%= scope.lookupvar('jellyfin::timezone') %>
# The Jellyfin version to use
JELLYFIN_VERSION=<%= scope.lookupvar('jellyfin::jellyfin_version') %>
# UID/GID the container runs as
PUID=<%= scope.lookupvar('jellyfin::uid') %>
PGID=<%= scope.lookupvar('jellyfin::gid') %>
# Host port for the web UI
HTTP_PORT=<%= scope.lookupvar('jellyfin::http_port') %>

<% if scope.lookupvar('jellyfin::cloudflare_tunnel_token') -%>
# API Token for Cloudflared tunnel
CLOUDFLARE_TUNNEL_TOKEN=<%= scope.lookupvar('jellyfin::cloudflare_tunnel_token') %>
<% end -%>