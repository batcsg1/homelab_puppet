name: jellyfin
services:
  jellyfin:
    container_name: jellyfin
    image: docker.io/jellyfin/jellyfin:${JELLYFIN_VERSION:-latest}
    user: ${PUID}:${PGID}
    volumes:
      - ${JELLYFIN_CONFIG}:/config
      - ${JELLYFIN_CACHE}:/cache
      - ${MEDIA_LOCATION}:/media:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      - TZ=${TZ}
    ports:
      - '${HTTP_PORT}:8096'
<% if $jellyfin::hardware_acceleration { -%>
    # Intel/AMD VAAPI/QSV hardware transcoding
    devices:
      - /dev/dri:/dev/dri
<% } -%>
    restart: unless-stopped
